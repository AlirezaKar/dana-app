# ===========================================================================
#  بیمه دانا — نمونهٔ فایل تنظیمات  |  DANA — sample configuration
# ===========================================================================
#  این فایل را به «.env» کپی کنید و مقادیر را تغییر دهید:
#     cp .env.sample .env
#  Copy this file to «.env» and change the values:  cp .env.sample .env
#
#  - هر خط «KEY=value» است؛ خطوط شروع‌شده با # توضیح هستند.
#  - مقدار خالی (KEY=) یعنی «مقدار پیش‌فرض کد».
#  - متغیر محیطی واقعی بر فایل اولویت دارد و می‌توانید برای یک اجرا مقدار
#    را موقت تغییر دهید:   DANA_CAR_IMAGE_MAX_GAP_SECONDS=3 python manage.py runserver
# ===========================================================================

# ---------------------------------------------------------------- Django ----
# Production: a long random string.  Dev value is fine to keep as it is.
SECRET_KEY=django-insecure-dana-dev-key-0f8c3d2a-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
LANGUAGE_CODE=fa-IR
TIME_ZONE=Asia/Tehran

# Paths — relative to the project root unless absolute.
SQLITE_NAME=db.sqlite3
# v1.16 — one statics/ folder for everything: {css,js,font,img} are the
# sources; `manage.py collectstatic` merges the rest (admin/) into it.
STATIC_URL=/static/
STATIC_ROOT=statics
# cache-buster for css/js links — bump when static assets change
STATIC_VERSION=1.17

# v1.18 — absolute base URL for the watermark QR code target (optional).
# Empty = the QR is skipped when the request cannot provide the URL.
PUBLIC_BASE_URL=
STORAGE_ROOT=storage

# ------------------------------------------------------------ brand links ---
DANA_URL=https://www.dana-insurance.com/
HEF_URL=http://127.0.0.1:6060

# ------------------------------------------------------- timing / case rules -
# Max gap between two consecutive uploads of the timed groups («شماره شاسی و
# پلاک‌ها» / «اطراف ماشین») in seconds — the same value for every part; also
# editable inside the app while developing (see DEV_TOOLS).
CAR_IMAGE_MAX_GAP_SECONDS=10
# Max first-to-last span of those same groups (minutes).
CAR_IMAGE_MAX_SPAN_MINUTES=10

# Session timeout (seconds) — the countdown popup + automatic logout.
# The warning popup shows only in the LAST 15 seconds (owner request).
SESSION_TIMEOUT_SECONDS=600
SESSION_TIMEOUT_WARN_SECONDS=15
# idle = counted from the last request | absolute = counted from the login
SESSION_TIMEOUT_MODE=idle

# ------------------------------------------------------------- switches -----
# Re-import the Excel files from storage/data/ on every server (re)start.
AUTO_SYNC_EXCEL_ON_START=True
# Re-import them again when the files changed and an info page is opened (GET).
AUTO_SYNC_ON_PAGE_VIEW=True
# Write page views + every action into the user activity log.
ACTIVITY_LOG=True
# Development helpers: the tiny unlabeled box at the bottom of every page, which
# changes CAR_IMAGE_MAX_GAP_SECONDS live (it is stored in the session, never
# written back here). Set to False on a real installation.
DEV_TOOLS=True
# Show Django error pages (DEBUG) only in development — keep DEBUG=False + a real
# SECRET_KEY + ALLOWED_HOSTS for production.

# ------------------------------------------------------------ watermark -----
# Burned into every stored photo (app_media/services/watermark.py — the single
# watermark module; run it manually with
# `python -m app_media.services.watermark --help`).
# Stamp = the two logos + these text lines (no GPS): تاریخ و ساعت، کد رایانه
# پرونده، شماره پرونده، شماره پلاک، شماره بیمه نامه، نام کاربری.
WATERMARK_ENABLED=True
WATERMARK_POSITION=bottom-left
WATERMARK_OPACITY=0.85
# 1.0 = stamp font ≈ 2.6 % of the image's short side.
WATERMARK_SCALE=1.0
# The stamp never covers more than this share of the image width.
WATERMARK_MIN_WIDTH_FRACTION=0.55
# Brand logos printed first; comma-separated paths inside static/.
WATERMARK_LOGOS=img/dana-logo.png,img/hef.co.ir.png
# Also write the stamp items (except the logos) into the image comment field.
WATERMARK_WRITE_COMMENT=True

# v1.20 — watermark extras. The custom text is stamped under the four values;
# Persian/Arabic text is shaped correctly (joined letters) as is Latin.
WATERMARK_CUSTOM_TEXT=
# Set to false to hide the custom text from the watermark overlay entirely.
WATERMARK_CUSTOM_TEXT_ENABLED=true
# Set to false to never stamp the QR code (the text watermark is unaffected).
WATERMARK_QR_ENABLED=true
