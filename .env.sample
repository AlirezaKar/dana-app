# =============================================================================
# dana-app — نمونهٔ تنظیمات (copy this file to `.env` and adjust)
#
#   * every key is optional: the code falls back to the default written here
#   * read order (see dana/env.py):  DANA_<KEY>  >  <KEY>  >  this file  >  default
#   * one setting per line,  KEY=value  (no spaces around `=`, no quotes needed)
#   * `true/false` (or 1/0) for the boolean keys
# =============================================================================

# --- server ------------------------------------------------------------------
# `manage.py runserver`  = development only (auto-reload, debug pages).
# For real use run:  python manage.py serve --collectstatic
DANA_SERVER_HOST=0.0.0.0
DANA_SERVER_PORT=8000
DANA_SERVER_THREADS=8

# --- paths (relative paths are resolved from the project root) ---------------
DANA_DB_PATH=db.sqlite3
DANA_STATIC_ROOT=statics
DANA_STORAGE_ROOT=storage
DANA_STATIC_URL=/static/
# bump to force every browser to fetch the css/js again (cache busting)
DANA_STATIC_VERSION=1.21
DANA_MEDIA_URL=/media/

# --- security ----------------------------------------------------------------
# Leave SECRET_KEY empty to let it be generated (dev convenience).
# On a shared server set a long random value — it signs the sessions.
DANA_SECRET_KEY=
DANA_DEBUG=False
DANA_ALLOWED_HOSTS=
# public origin used in links that must work outside the app (the QR code on the
# photos). Empty = built from the incoming request.
DANA_PUBLIC_BASE_URL=

# --- locale ------------------------------------------------------------------
DANA_LANGUAGE_CODE=fa-IR
DANA_TIME_ZONE=Asia/Tehran

# --- session timeout ---------------------------------------------------------
# Seconds without any activity before the session ends; the page counts down
# and shows a popup («ادامهٔ کار» / «خروج») before the user is sent to the login
# page. Any request refreshes the timer.
DANA_SESSION_TIMEOUT_SECONDS=600
DANA_SESSION_TIMEOUT_WARN_SECONDS=15
# 'idle'     -> counted from the last request (any click/page keeps you in)
# 'absolute' -> counted from the moment of login, no matter what you do
DANA_SESSION_TIMEOUT_MODE=idle

# --- upload rules ------------------------------------------------------------
# Only HEIF/HEIC, JPEG/JPG, PNG and RAW (DNG / Apple ProRAW) are accepted, and
# every file is stored in the format it came in (no conversion). The accepted
# list is fixed by the owner and deliberately not configurable here.
# How many photos one field may hold is fixed per field in
# app_media/constants.py (SECTION_CHOICES: min/max) — also not configurable.

# --- photo timing (the «اطراف ماشین» + «پلاک‌ها» groups) ----------------------
DANA_CAR_IMAGE_MAX_GAP_SECONDS=10
DANA_CAR_IMAGE_MAX_SPAN_MINUTES=10

# --- brand: logo links + logo files (ONE place; swap the image file and every
#     page and the watermark stamp change with it) ---------------------------
DANA_DANA_URL=https://www.dana-insurance.com/
DANA_HEF_URL=http://hef.co.ir
DANA_DANA_LOGO=img/dana-logo.png
DANA_HEF_LOGO=img/hef.co.ir.png

# --- watermark burned into every stored photo (HEIC/DNG are stored as-is) ----
# False = store the raw upload, no stamp at all
DANA_WATERMARK_ENABLED=True
# top-left | top-right | bottom-left | bottom-right
DANA_WATERMARK_POSITION=bottom-right
DANA_WATERMARK_OPACITY=0.85
# 1.0 = the stamp's font is about 2.6% of the photo's short side
DANA_WATERMARK_SCALE=1.0
DANA_WATERMARK_MIN_WIDTH_FRACTION=0.55
# the same facts also go into the file's metadata (Properties -> Details)
DANA_WATERMARK_WRITE_COMMENT=True
# the QR code that opens the public /wm-info/ page
DANA_WATERMARK_QR_ENABLED=True
# an extra free-text line on the stamp (and its on/off switch)
DANA_WATERMARK_CUSTOM_TEXT=
DANA_WATERMARK_CUSTOM_TEXT_ENABLED=True
# the stamp's logo files — empty means «use the two brand logos above»
#DANA_WATERMARK_LOGOS=img/dana-logo.png,img/hef.co.ir.png

# --- Excel sync (storage/data/*.xlsx) ----------------------------------------
DANA_AUTO_SYNC_EXCEL_ON_START=True
DANA_AUTO_SYNC_ON_PAGE_VIEW=True

# --- logging / development helpers -------------------------------------------
DANA_ACTIVITY_LOG=True
# the tiny box in the footer of the upload page (session timer + the
# CAR_IMAGE_MAX_GAP_SECONDS override); on by default in debug mode only
DANA_DEV_TOOLS=False
